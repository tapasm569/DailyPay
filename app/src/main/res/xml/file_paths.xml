<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Fallback internal storage directory -->
    <files-path
        name="internal_files"
        path="." />

    <!-- Internal cache directory -->
    <cache-path
        name="cached_pdfs"
        path="." />

    <!-- External app-specific storage (covers Documents and all subfolders) -->
    <external-files-path
        name="external_files"
        path="." />

    <!-- Public external storage -->
    <external-path
        name="external_storage_root"
        path="." />
</paths>
